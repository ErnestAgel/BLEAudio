<mxfile host="app.diagrams.net" modified="2026-11-20T01:45:00.000Z" agent="Antigravity" version="24.0.0"><diagram id="ota-debug-flow" name="BLE OTA 调试排查路径与线程/DMA 边界"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="BLE OTA (MCUboot Direct-XIP + Revert) 故障排查全流程与硬件边界
覆盖非 OTA 门控 · VERSION Pristine · MCUmgr 优先级抢占 · 89.7 ms 整页擦除击穿 120 ms WDT 四大实测问题" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="14" width="1240" height="50" as="geometry"/></mxCell><mxCell id="c4" value="一、实机 OTA 四阶段故障定位与修复演进" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;dashed=1;" vertex="1" parent="1"><mxGeometry x="25" y="80" width="770" height="655" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;问题 1：手机连上即报错&lt;/b&gt;&lt;br&gt;DFU chunk rejected: not in OTA state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.8;fontColor=#0f172a;align=center;" vertex="1" parent="1"><mxGeometry x="48" y="120" width="315" height="76" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;安全门控生效：未按 BTN4 进入 SYS_STATE_OTA&lt;/b&gt;&lt;br&gt;按 BTN4 停采集并点亮 LED3 呼吸灯后放行" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.8;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="120" width="360" height="76" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.8;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="363" y="158" as="sourcePoint"/><mxPoint x="415" y="158" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;问题 2：改 VERSION 后增量编译&lt;/b&gt;&lt;br&gt;升级重启仍运行旧版本 v0.1.0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.8;fontColor=#0f172a;align=center;" vertex="1" parent="1"><mxGeometry x="48" y="215" width="315" height="76" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;dfu_application.zip manifest 未更新版本号&lt;/b&gt;&lt;br&gt;改 VERSION 后执行 ./build.ps1 -Pristine 重打双槽" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.8;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="215" width="360" height="76" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.8;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="363" y="253" as="sourcePoint"/><mxPoint x="415" y="253" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;问题 3：传固件中途复位 (12.3s 内)&lt;/b&gt;&lt;br&gt;RTT: RESETREAS=0x00000002 (DOG)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.8;fontColor=#0f172a;align=center;" vertex="1" parent="1"><mxGeometry x="48" y="315" width="315" height="76" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;LOG_MODE_IMMEDIATE：MCUmgr 默认 Prio 3 饿死 sys_mgr&lt;/b&gt;&lt;br&gt;设 WORKQUEUE_THREAD_PRIO=9 + STACK=4096" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.8;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="315" width="360" height="76" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.8;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="363" y="353" as="sourcePoint"/><mxPoint x="415" y="353" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;问题 4：刚进 OTA 准备传固件即复位&lt;/b&gt;&lt;br&gt;无业务日志 · RESETREAS=0x00000002" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=1.8;fontColor=#0f172a;align=center;" vertex="1" parent="1"><mxGeometry x="48" y="415" width="315" height="76" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;89.7 ms 整页擦除阻塞 CPU 取指，击穿 120 ms 硬件后备 WDT&lt;/b&gt;&lt;br&gt;开 PARTIAL_ERASE_MS=3 (3ms切片) + WDT 窗口扩至 1500 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.8;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="415" y="415" width="360" height="76" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475569;strokeWidth=1.8;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="363" y="453" as="sourcePoint"/><mxPoint x="415" y="453" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;实机闭环验证日志 (firmware v0.1.3, nRF Connect Device Manager)&lt;/b&gt;&lt;br&gt;[00:00:15.919] ota_dfu: DFU started  -&amp;gt;  12.3s 上传完成 (11.7 kB/s)&lt;br&gt;[00:00:28.498] ota_dfu: SMP OS reset requested  -&amp;gt;  RESETREAS=0x00000004 (SREQ)&lt;br&gt;&lt;b&gt;[00:00:00.016] ota_dfu: Self-check: LittleFS + DMIC OK -&amp;gt; New image confirmed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.8;fontColor=#1e3a8a;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="48" y="520" width="727" height="92" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;防变砖 Revert 回滚机制 (Direct-XIP with Revert)&lt;/b&gt;&lt;br&gt;新槽位首启未调用 boot_write_img_confirmed() 前若发生 WDT/自检失败复位，&lt;br&gt;MCUboot 二次启动自动擦除故障槽位并回退原可用 Bank，确保现场永不变砖。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f3e8ff;strokeColor=#7c3aed;strokeWidth=1.8;fontColor=#4c1d95;align=center;" vertex="1" parent="1"><mxGeometry x="48" y="632" width="727" height="82" as="geometry"/></mxCell><mxCell id="c19" value="二、线程优先级分层与硬件 DMA / NVMC 边界" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="515" height="655" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;SDC / BT 协议栈 + k_sys_work_q (抢占高优)&lt;/b&gt;&lt;br&gt;RADIO EasyDMA 空中收发 SMP / L2CAP 数据包" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e2e8f0;strokeColor=#475569;strokeWidth=1.8;fontColor=#0f172a;align=center;" vertex="1" parent="1"><mxGeometry x="845" y="125" width="465" height="68" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;音频链路线程 Prio 4~7 (与 OTA 严格互斥)&lt;/b&gt;&lt;br&gt;audio_cap(4) -&amp;gt; audio_dsp(5) -&amp;gt; ble_tx(6) / audio_store(7)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e0f2fe;strokeColor=#0284c7;strokeWidth=1.8;fontColor=#0c4a6e;align=center;" vertex="1" parent="1"><mxGeometry x="845" y="210" width="465" height="76" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;sys_mgr_task (Prio 8) · 高于 MCUmgr&lt;/b&gt;&lt;br&gt;状态机互斥 + LED3 PWM0 呼吸 + task_wdt 定期喂狗" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=1.8;fontColor=#14532d;align=center;" vertex="1" parent="1"><mxGeometry x="845" y="303" width="465" height="68" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;MCUMGR_TRANSPORT_WORKQUEUE (Prio 9, 4 KB)&lt;/b&gt;&lt;br&gt;低优先级运行不饿死喂狗；仅 SYS_STATE_OTA 态放行" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.8;fontColor=#78350f;align=center;" vertex="1" parent="1"><mxGeometry x="845" y="388" width="465" height="74" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;OTA 硬件数据流与片内 Flash 擦写边界&lt;/b&gt;&lt;br&gt;1. 手机 App --(BLE 2.4GHz)--&amp;gt; RADIO EasyDMA --&amp;gt; RAM net_buf&lt;br&gt;2. MCUmgr img_mgmt --(flash_sync_mpsl)--&amp;gt; 申请 MPSL 空闲时隙&lt;br&gt;3. 片内 Flash NVMC 无 DMA：CPU 同步执行擦写并暂停 Flash 取指&lt;br&gt;   · 未切片：整页 4 KB 擦除 ~89.7 ms (易撞穿 120 ms WDT)&lt;br&gt;&lt;b&gt;   · PARTIAL_ERASE_MS=3：拆分为 3 ms 时间片，WDT 零超时&lt;/b&gt;&lt;br&gt;4. 写入空闲槽 Slot 0 / Slot 1 (各 472 KB) -&amp;gt; 重启 Direct-XIP 跳转&lt;br&gt;5. 自检 LittleFS + DMIC 通过 -&amp;gt; 写入 Image OK 永久固化" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#1e40af;strokeWidth=1.8;fontColor=#1e3a8a;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="845" y="486" width="465" height="228" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>